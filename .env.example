## NEXUS — Environment Configuration Template
## Copy this file to .env and fill in your values:
##   cp .env.example .env

# ────────────────────────────────────────────
#  NVIDIA NIM (Primary AI Provider)
#  Get your key at: https://integrate.api.nvidia.com
# ────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...

# ────────────────────────────────────────────
#  Nebius AI Studio (Alternative Provider)
#  Get your key at: https://studio.nebius.ai
# ────────────────────────────────────────────
# NEBIUS_API_KEY=...

# ────────────────────────────────────────────
#  GitHub Integration (Optional — for real PR creation)
#  Create a Personal Access Token at: https://github.com/settings/tokens
#  Required scopes: repo (read/write)
# ────────────────────────────────────────────
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=owner/repository-name

# ────────────────────────────────────────────
#  Frontend Configuration (Next.js)
# ────────────────────────────────────────────
# NEXT_PUBLIC_BACKEND_URL=127.0.0.1:8000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/nexus
